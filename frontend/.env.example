# Copy to .env.local to override. Every value is optional.

# Absolute base URL of the SatQuery backend, for deployments where the API is
# on a different origin. Leave unset in development: the Vite dev server
# proxies /api, /health and /capabilities to the FastAPI process, which keeps
# the browser same-origin and avoids CORS entirely.
# VITE_API_BASE_URL=https://api.example.org

# Where the dev-server proxy points. Defaults to http://127.0.0.1:8000.
# VITE_DEV_BACKEND=http://127.0.0.1:8000

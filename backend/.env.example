# Copy this file to .env and edit it. Every setting is optional --
# SatQuery runs with none of them set, offline and at no cost.


# Natural-language understanding.
# Leave unset: an offline keyword engine reads the query.
# Set a key:   a hosted model reads it instead.
# Free keys (no card): https://console.groq.com/keys
# SATQUERY_AGENT_API_KEY=

# Only if you are not using Groq.
# OpenRouter: https://openrouter.ai/api/v1  +  meta-llama/llama-3.3-70b-instruct:free
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai  +  gemini-2.0-flash
# SATQUERY_AGENT_HOSTED_BASE_URL=
# SATQUERY_AGENT_HOSTED_MODEL=

# Or a model on your own machine, no key needed (https://ollama.com).
# SATQUERY_AGENT_PROVIDER=ollama


# The vision-language model core: visual question answering ("Is there a
# river in this image?"), captioning with region grounding ("Describe this
# image") and change-VQA ("What happened between these two dates?").
# Off by default: with the hosted provider it sends a rendered PREVIEW OF THE
# IMAGE to the vision model, which is a bigger step than sending the
# question's text, and needs SATQUERY_AGENT_API_KEY as well. Every other
# capability runs offline.
# SATQUERY_VQA_ENABLED=true

# hosted (default): any OpenAI-compatible endpoint -- Groq, or a fine-tuned
#                   model you serve with vLLM or TGI.
# ollama:           a vision model on this machine; no key, nothing leaves it.
# SATQUERY_VQA_PROVIDER=hosted

# A vision-capable model. Empty means the provider's default
# (meta-llama/llama-4-scout-17b-16e-instruct hosted, llama3.2-vision on Ollama).
# SATQUERY_VQA_MODEL=
# SATQUERY_VQA_BASE_URL=

# A key for SATQUERY_VQA_BASE_URL, if that endpoint needs one. The Groq key
# above is only ever sent to Groq, never to a self-hosted model such as the
# fine-tuned one in finetune/.
# SATQUERY_VQA_API_KEY=

# A report from scripts/evaluate_benchmark.py. When it covers the configured
# model, answers that model writes carry its measured accuracy as confidence;
# without one they are shown as unrated. Default: evaluation_reports/latest.json
# SATQUERY_VQA_BENCHMARK_REPORT=


# Where uploads and generated rasters are written.
# SATQUERY_STORAGE_ROOT=

# Browser origins allowed to call the API.
# SATQUERY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# DEBUG | INFO | WARNING | ERROR
# SATQUERY_LOG_LEVEL=INFO

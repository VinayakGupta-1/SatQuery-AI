# Copy this file to .env and edit it. Every setting is optional --
# SatQuery runs with none of them set, at no cost. The one thing it
# reaches the internet for by default is imagery: a question asked
# without an upload fetches a free Sentinel scene (see the end of this
# file to turn that off).


# Natural-language understanding.
# Leave unset: an offline keyword engine reads the query.
# Set a key:   a hosted model reads it instead.
# Free keys (no card): https://console.groq.com/keys
# SATQUERY_AGENT_API_KEY=

# Only if you are not using Groq.
# OpenRouter: https://openrouter.ai/api/v1  +  meta-llama/llama-3.3-70b-instruct:free
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai  +  gemini-2.0-flash
# SATQUERY_AGENT_HOSTED_BASE_URL=
# SATQUERY_AGENT_HOSTED_MODEL=

# Or a model on your own machine, no key needed (https://ollama.com).
# SATQUERY_AGENT_PROVIDER=ollama


# The vision-language model core: visual question answering ("Is there a
# river in this image?"), captioning with region grounding ("Describe this
# image") and change-VQA ("What happened between these two dates?").
# Off by default: with the hosted provider it sends a rendered PREVIEW OF THE
# IMAGE to the vision model, which is a bigger step than sending the
# question's text, and needs SATQUERY_AGENT_API_KEY as well. Every other
# capability runs offline.
# SATQUERY_VQA_ENABLED=true

# hosted (default): any OpenAI-compatible endpoint -- Groq, or a fine-tuned
#                   model you serve with vLLM or TGI.
# ollama:           a vision model on this machine; no key, nothing leaves it.
# SATQUERY_VQA_PROVIDER=hosted

# A vision-capable model. Empty means the provider's default
# (qwen/qwen3.8-27b hosted on Groq, llama3.2-vision on Ollama). Groq retires
# models over time: https://console.groq.com/docs/models
# SATQUERY_VQA_MODEL=
# SATQUERY_VQA_BASE_URL=

# A key for SATQUERY_VQA_BASE_URL, if that endpoint needs one. The Groq key
# above is only ever sent to Groq, never to a self-hosted model such as the
# fine-tuned one in finetune/.
# SATQUERY_VQA_API_KEY=

# A report from scripts/evaluate_benchmark.py. When it covers the configured
# model, answers that model writes carry its measured accuracy as confidence;
# without one they are shown as unrated. Default: evaluation_reports/latest.json
# SATQUERY_VQA_BENCHMARK_REPORT=


# Automatic imagery. A question asked without an upload names a place
# ("vegetation in Pune") or coordinates; SatQuery finds it with
# OpenStreetMap's geocoder and downloads Sentinel-2 L2A (optical) or
# Sentinel-1 RTC (radar, for floods) for just that area from Microsoft
# Planetary Computer. Free, no account. Needs rasterio (GDAL).
# Set to false where the server must not reach the internet.
# SATQUERY_FETCH_ENABLED=true

# Largest area fetched for one question, in km; a larger place is cut to
# a square of this size around its centre. Side of the square fetched
# around a point. Longest side of a fetched image in pixels: larger
# areas are read at 20/40/80 m. Download time grows with all three.
# SATQUERY_FETCH_MAX_EXTENT_KM=20
# SATQUERY_FETCH_DEFAULT_EXTENT_KM=10
# SATQUERY_FETCH_MAX_PIXELS=1024

# Catalogue tiles cloudier than this are skipped (percent), and how many
# days back "now" reaches when a question names no date.
# SATQUERY_FETCH_MAX_CLOUD_PERCENT=60
# SATQUERY_FETCH_LOOKBACK_DAYS=120

# Where uploads and generated rasters are written.
# SATQUERY_STORAGE_ROOT=

# Task files older than this many hours are deleted at startup (task history
# lives in memory, so nothing from an earlier run can be served again).
# 0 keeps everything.
# SATQUERY_RETENTION_HOURS=24

# Accounts. With both set, people sign up (email + password), verify their
# address from the email Supabase sends, and sign in; every analysis needs
# their access token and their results are stored per user in the
# project's `analyses` table (row level security). Unset: the API is open.
# Both values are public by design. Find them in the Supabase dashboard
# under Project Settings -> API.
# SATQUERY_SUPABASE_URL=https://<project-ref>.supabase.co
# SATQUERY_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Browser origins allowed to call the API.
# SATQUERY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# DEBUG | INFO | WARNING | ERROR
# SATQUERY_LOG_LEVEL=INFO
